# Leave blank until the official domain is owned and ready. Rebuild after changes.
# Use the full public HTTPS origin, without a path, query, credentials, or port.
NEXT_PUBLIC_SITE_URL=

# Set false for previews, including previews with a configured canonical origin.
NEXT_PUBLIC_SITE_INDEXABLE=true

# Optional: real ownership verification tokens from the corresponding accounts.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
